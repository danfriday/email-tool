# ============================================================
#  Next.js app (Netlify) — server-side secrets
# ============================================================
# Supabase project URL + service-role key (server only, bypasses RLS).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public Supabase config (used by the browser + auth session).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Storage / flyer image
SUPABASE_BUCKET=flier
SUPABASE_FLYER_FILE=IMG-20260428-WA0160.jpg
NEXT_PUBLIC_SUPABASE_BUCKET=flier
NEXT_PUBLIC_SUPABASE_FLYER_FILE=IMG-20260428-WA0160.jpg
FLYER_IMAGE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/flier/IMG-20260428-WA0160.jpg

# Sender identity (defaults for new campaigns).
FROM_EMAIL=noreply@example.com
FROM_NAME="Praise Party 3.0"

# Worker trigger (optional, for instant pickup after queueing).
# The pg_cron schedule is the guaranteed path; this just avoids a ~1 min wait.
WORKER_URL=https://your-project-ref.functions.supabase.co/process-queue
WORKER_SECRET=generate-a-long-random-string

# Resend bounce/complaint webhook auth (set ONE of these).
RESEND_WEBHOOK_SIGNING_SECRET=
RESEND_WEBHOOK_TOKEN=

# ============================================================
#  Supabase Edge Function `process-queue` — set with:
#    supabase secrets set KEY=value
#  (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are injected automatically)
# ------------------------------------------------------------
#  RESEND_API_KEY=your-resend-api-key
#  FROM_EMAIL=noreply@example.com
#  FROM_NAME="Praise Party 3.0"
#  FLYER_IMAGE_URL=https://.../flier/IMG-20260428-WA0160.jpg
#  WORKER_SECRET=same-long-random-string-as-above
#  RESEND_SEND_DELAY_MS=600   # pace under Resend's rate limit
# ============================================================
