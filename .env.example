# Supabase server-side configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=flier
SUPABASE_FLYER_FILE=IMG-20260428-WA0160.jpg

# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_BUCKET=flier
NEXT_PUBLIC_SUPABASE_FLYER_FILE=IMG-20260428-WA0160.jpg
NEXT_PUBLIC_FLYER_IMAGE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/flier/IMG-20260428-WA0160.jpg

# Resend API
RESEND_API_KEY=your-resend-api-key
# Delay between sends in ms. 600 stays under Resend's free-tier 2 req/sec limit.
# Lower this on paid plans with higher rate limits.
RESEND_SEND_DELAY_MS=600
# Resend webhook signing secret (whsec_...), from the Resend dashboard.
# Recommended — verifies the Svix signature on every bounce/complaint webhook.
RESEND_WEBHOOK_SIGNING_SECRET=
# Legacy alternative: shared secret via /api/webhooks/resend?token=...
RESEND_WEBHOOK_TOKEN=

# Sender configuration
FROM_EMAIL=noreply@example.com
FROM_NAME="Praise Party 3.0"
NEXT_PUBLIC_FROM_EMAIL=noreply@example.com
